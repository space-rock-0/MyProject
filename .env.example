# --- Career-ops web app ---
# Groq key for the app itself (assistant, Add Job, Outreach parse)
GROQ_API_KEY=
# Model used by the app features
GROQ_MODEL=openai/gpt-oss-120b

# --- Personal Drafter (separate key) ---
# Your Personal Drafter Groq key (different from the app's GROQ_API_KEY)
PD_GROQ_API_KEY=
# Models tried in order, first wins; limits are per model
PD_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
# OAuth callback URL for Gmail. Must match one Authorized Redirect URI in your
# Google Cloud Console OAuth client. Defaults to <your-request-origin>/auth/google/callback
# PD_GOOGLE_REDIRECT_URI=https://your-app.onrender.com/auth/google/callback

# --- Data directory ---
# Where job-tracker.json / outreach-tracker.json live. Default: ./data
# Set this to your Render persistent-disk mount for data that survives redeploys.
# CAREER_OPS_DATA_DIR=/var/data/career-ops
