# Free key: https://console.groq.com/keys
GROQ_API_KEY=

# Tried in order. If one is rate limited, the next one is used (limits are per model).
# Check console.groq.com/docs/models for current IDs and edit freely.
GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b

# Folder with Email/, Linkedin/, CV/, Resumes/, Resume_org/
DATA_DIR=Personal Drive

PORT=8000
